#!/bin/sh
# Fill the sshd drop-in's password Match with the build's addresses: a
# comma-separated list of addresses and CIDR ranges. An empty list drops the
# Match, so no address takes a password. Anything else is refused, so the
# build argument cannot add other sshd settings to the file.
set -eu
addresses=$1
file=$2
case $addresses in
*[!0-9A-Fa-f:.,/]*)
    echo "SSHD_PASSWORD_ADDRESSES: '$addresses' is not a list of addresses" >&2
    exit 1 ;;
esac
if [ -n "$addresses" ]; then
    sed -i "s|@SSHD_PASSWORD_ADDRESSES@|$addresses|" "$file"
else
    sed -i '/^Match Address /,$d' "$file"
fi
if grep -q @SSHD_PASSWORD_ADDRESSES@ "$file"; then
    echo "$file: the address placeholder is still there" >&2
    exit 1
fi
